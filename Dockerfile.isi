FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 ISI_DATA=/data ISI_PORT=8000 ISI_BIND=0.0.0.0
RUN useradd --system --uid 10001 --home-dir /app isi && mkdir -p /data && chown isi /data
WORKDIR /app
COPY tools/bangun /app/tools/bangun
COPY font /app/font
COPY salon/img /app/salon/img
COPY barbershop/img /app/barbershop/img
COPY spa/img /app/spa/img
COPY penginapan/img /app/penginapan/img
COPY katering/img /app/katering/img
USER isi
VOLUME /data
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s CMD python -c "import urllib.request,os;urllib.request.urlopen('http://127.0.0.1:%s/healthz' % os.environ.get('ISI_PORT','8000'),timeout=2)" || exit 1
CMD ["python", "tools/bangun/isi.py"]
